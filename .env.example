# 크론이 읽을 자격증명. 이 파일을 .env 로 복사해서 값을 채운다.
#
#   cp .env.example .env && chmod 600 .env
#
# .env 는 .gitignore 에 있다. 값을 채운 파일은 절대 커밋하지 않는다.
# 크론은 로그인 셸이 아니라 ~/.bashrc 를 안 읽는다 — 그래서 이 파일이 필요하다.
# scripts/cron-run.sh 가 실행 직전에 읽는다.

# 키움 REST API (개발자센터에서 모의투자용·실전용을 따로 발급받는다)
KIWOOM_APP_KEY=
KIWOOM_APP_SECRET=
KIWOOM_ACCOUNT_NUMBER=

# paper = 모의투자, real = 실전.
# 승격 경로상 실전은 사람의 명시적 승인 없이는 열 수 없다. paper 로 둔다.
KIWOOM_MODE=paper
